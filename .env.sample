DOCKER_DB_ROOT_PASSWORD=your_secure_password_here

# Database Backup Configuration
# Schedule for backups (cron format: minute hour day month weekday)
# Default: 0 3 * * * (daily at 3:00 AM)
BACKUP_CRON=0 3 * * *

# Backup filename pattern
# Default: backup-%Y-%m-%dT%H-%M-%S.tar.gz
BACKUP_FILENAME=backup-%Y-%m-%dT%H-%M-%S.tar.gz

# Number of days to retain backups
# Default: 7 days
BACKUP_RETENTION_DAYS=7

# Auto-confirmation for pruning old backups
# Default: y (yes)
BACKUP_PRUNING_LETTERS_DELETE=y

# AWS S3 Configuration (for storing backups)
# Leave empty to disable S3 uploads and store locally
BACKUP_AWS_S3_BUCKET_NAME=docker-volume-backup
BACKUP_AWS_S3_PATH=/azerothcore-backups
BACKUP_AWS_ENDPOINT=https://s3.amazonaws.com
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
